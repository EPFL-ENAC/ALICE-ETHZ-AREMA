# Copy to .env and fill in the secrets: cp .env.example .env
# Commented-out variables are optional and show their default value.

# Postgres (also used by docker compose to create the database)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=arema
#DB_PREFIX=postgresql+asyncpg
# Overrides the URL built from the DB_* variables above
#DB_URL=

# FastAPI root path (defaults to /api)
PATH_PREFIX=

# Keycloak
#KEYCLOAK_REALM=AREMA
#KEYCLOAK_URL=https://enac-it-sso.epfl.ch
KEYCLOAK_API_ID=local-api
KEYCLOAK_API_SECRET=xxxxx
#KEYCLOAK_TOTP=false

# S3
S3_ENDPOINT_PROTOCOL=https://
S3_ENDPOINT_HOSTNAME=s3.epfl.ch
S3_REGION=EU
S3_ACCESS_KEY_ID=xxxxx
S3_SECRET_ACCESS_KEY=xxxxx
S3_BUCKET=xxxxx
# e.g. with arema/local/ the file URLs start with /s3/arema/local/
S3_PATH_PREFIX=arema/local/

# Elasticsearch
ES_URL=http://localhost:9200

# Rate limiting
#RATE_LIMIT_ENABLED=true
#RATE_LIMIT_DEFAULT=100/minute
#RATE_LIMIT_REGISTER=5/minute

# Mail/SMTP
#SMTP_HOST=mail.epfl.ch
#SMTP_PORT=25
#SMTP_EMAIL=noreply+arema@epfl.ch
#SMTP_NAME=AREMA
#SMTP_USERNAME=
#SMTP_PASSWORD=
#MAIL_SUBJECT_PREFIX=[AREMA]
# Comma-separated emails of the administrators to notify (empty: all)
#MAIL_ADMINISTRATORS=
